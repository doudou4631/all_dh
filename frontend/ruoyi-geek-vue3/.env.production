# 页面标题
VITE_APP_TITLE = 号码标记管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 号码标记管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 路由基础路径
VITE_BASE_ROUTER = /

# 泰迪熊二次线路：线路2作为备用，线路1和线路3可用
VITE_TDX_LINE1_MAINTENANCE = false
VITE_TDX_LINE2_MAINTENANCE = false
VITE_TDX_LINE3_MAINTENANCE = false
