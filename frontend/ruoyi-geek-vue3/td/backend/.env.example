PORT=4320
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:4321

# Session signing
TD_SESSION_SECRET=change-me-in-production
TD_SESSION_TTL_SECONDS=43200

# MySQL (same as RightControl or your target DB)
RIGHTCONTROL_DB_HOST=127.0.0.1
RIGHTCONTROL_DB_PORT=3306
RIGHTCONTROL_DB_USER=root
RIGHTCONTROL_DB_PASSWORD=YOUR_DB_PASSWORD
RIGHTCONTROL_DB_NAME=RightControl

# TDX upstream
TDX_MODE=live
TDX_ORIGINAL_IP=192.168.114.250
TDX_MAX_ORDER_REUSE=3
TDX_SEND_SMS_URL=https://customer-apply-diversion.teddymobile.cn/api/v1/as/auth/sendSms
TDX_LOGIN_SMS_URL=https://customer-apply-diversion.teddymobile.cn/api/v1/auth/login-sms

# QMF wxCode channel
QMF_LOGIN_URL=http://api.qmfj66pp.cn/public/userLogin
QMF_CODE_URL=http://api.qmfj66pp.cn/code
QMF_USERNAME=
QMF_PASSWORD=
QMF_APP_ID=78811
QMF_QR_CODE=1

# Line 2 is handled by the external API; no local provider credentials belong here.

# Proxy (when QMF/TDX requires dynamic IP)
TDX_PROXY_SOURCE_URL=
QMF_PROXY_SOURCE_URL=

# Auto check: resubmit + refund after 3 retries
ORDER_AUTOCHECK_ENABLED=1
ORDER_AUTOCHECK_INTERVAL_MS=1800000
ORDER_AUTOCHECK_BATCH_SIZE=20
ORDER_AUTOCHECK_LOOKBACK_DAYS=30

# Service-to-service (optional)
TDX_INTEGRATION_TOKEN=
TDX_INTEGRATION_USER_ID=
TDX_INTEGRATION_USERNAME=tdx-integration
