page {
  min-height: 100%;
  background: #e9f4ff;
}

.page { min-height: 100vh; overflow: hidden; box-sizing: border-box; background: #e9f4ff; color: #1a2340; }
.home-view { width: 100%; }
.hero { position: relative; width: 100%; overflow: hidden; background: #e9f4ff; }
.hero-image { display: block; width: 100%; vertical-align: top; }
.hero-title { position: absolute; left: 6%; right: 6%; bottom: 3%; height: 24%; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; pointer-events: none; }
.hero-title-main { color: #111; font-size: 60rpx; font-weight: 700; line-height: 1.2; letter-spacing: 1rpx; }
.hero-title-sub { margin-top: 8rpx; color: #666; font-size: 30rpx; line-height: 1.35; }

.content-section { width: 100%; box-sizing: border-box; background: #fff; }
.query-card { position: relative; z-index: 2; width: 100%; box-sizing: border-box; padding: 24rpx 32rpx 32rpx; background: #fff; }
.query-input-frame { display: flex; align-items: center; width: 100%; min-height: 96rpx; box-sizing: border-box; border: 3rpx solid #409eff; border-radius: 48rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(74,111,243,.12); }
.query-input { flex: 1; min-width: 0; height: 88rpx; box-sizing: border-box; padding: 0 8rpx 0 28rpx; color: #1a2340; font-size: 30rpx; font-weight: 500; letter-spacing: .5rpx; line-height: 88rpx; }
.query-placeholder { color: #a0adcc; font-size: 26rpx; }
.query-clear { flex: 0 0 auto; width: 38rpx; height: 38rpx; margin-right: 4rpx; border-radius: 50%; background: #d8e2f2; color: #6b7a99; font-size: 34rpx; line-height: 34rpx; text-align: center; }
.query-embed-button { display: flex; flex: 0 0 140rpx; align-items: center; justify-content: center; width: 140rpx; height: 76rpx; gap: 8rpx; margin: 0 8rpx 0 4rpx; box-sizing: border-box; border-radius: 38rpx; background: linear-gradient(135deg,#3989f5,#4b9df3); box-shadow: 0 4rpx 14rpx rgba(74,111,243,.26); color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1; text-align: center; white-space: nowrap; }
.query-button-label { line-height: 1; }
.query-embed-button::after, .back-button::after, .contact-button::after, .qr-close::after { border: 0; }
.query-embed-button.is-loading { opacity: .72; }
.query-button-hover { opacity: .86; transform: scale(.98); }

.platform-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 24rpx 10rpx; margin: 30rpx 0 4rpx; }
.platform-item { display: flex; flex-direction: column; align-items: center; min-width: 0; gap: 8rpx; }
.platform-logo { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; box-sizing: border-box; border: 1rpx solid rgba(216,228,245,.72); border-radius: 20rpx; background: #f8faff; box-shadow: 0 2rpx 10rpx rgba(74,111,243,.06); }
.platform-logo-image { width: 68rpx; height: 68rpx; }
.platform-name { width: 100%; overflow: hidden; color: #6b7a99; font-size: 22rpx; font-weight: 500; line-height: 1.25; text-align: center; text-overflow: ellipsis; white-space: nowrap; }

.error-box { margin: 24rpx 32rpx 0; padding: 22rpx 26rpx; border-radius: 12rpx; background: #fff1f0; color: #d55b4d; font-size: 26rpx; line-height: 1.5; }
.query-progress-modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 110; }
.query-progress-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,.52); }
.query-progress-panel { position: absolute; top: 50%; left: 50%; width: 620rpx; max-width: 88%; padding: 44rpx 36rpx; box-sizing: border-box; border-radius: 40rpx; background: #fff; transform: translate(-50%,-50%); }
.query-progress-title { margin-bottom: 28rpx; color: #303133; font-size: 30rpx; line-height: 1.5; text-align: center; }
.query-progress-track { position: relative; height: 48rpx; overflow: hidden; border-radius: 24rpx; background: #ebeef5; }
.query-progress-fill { height: 100%; border-radius: 24rpx; background: #67c23a; transition: width .1s linear; }
.query-progress-value { position: absolute; top: 0; right: 0; bottom: 0; left: 0; color: #1f4212; font-size: 26rpx; font-weight: 600; line-height: 48rpx; text-align: center; }
.home-bottom-poster { width: 100%; margin-top: 20rpx; background: #dceeff; }
.home-bottom-poster-image { display: block; width: 100%; vertical-align: top; }

.result-view { min-height: 100vh; box-sizing: border-box; padding-bottom: 32rpx; background: #f7f9fc; }
.result-header { position: relative; padding: 48rpx 32rpx 36rpx; overflow: hidden; background: linear-gradient(160deg,#3a7de6,#3b82e8 50%,#4a90ec); color: #fff; text-align: center; }
.result-header::after { position: absolute; right: -20rpx; bottom: -50rpx; width: 150rpx; height: 150rpx; border: 20rpx solid rgba(255,255,255,.12); border-radius: 50%; content: ''; }
.result-header-tip { position: relative; z-index: 1; color: rgba(255,255,255,.92); font-size: 28rpx; line-height: 1.6; }
.result-number { position: relative; z-index: 1; margin-top: 10rpx; color: #f5a623; font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; }
.result-summary { position: relative; z-index: 1; margin-top: 14rpx; color: #fff; font-size: 28rpx; }
.platform-section { width: calc(100% - 56rpx); margin: 30rpx auto 0; }
.platform-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.section-title { display: flex; align-items: center; gap: 12rpx; color: #1a2340; font-size: 30rpx; font-weight: 700; }
.section-title-bar { width: 8rpx; height: 34rpx; border-radius: 4rpx; background: #409eff; }
.platform-count { color: #9aa5bb; font-size: 24rpx; }
.result-platform-card { margin-top: 18rpx; padding: 28rpx 30rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(40,80,160,.1); }
.result-platform-main { display: flex; align-items: center; flex-wrap: wrap; }
.result-platform-icon { width: 72rpx; height: 72rpx; margin-right: 16rpx; border-radius: 12rpx; }
.result-platform-name { color: #3b82e8; font-size: 32rpx; font-weight: 600; }
.result-platform-tag { width: calc(100% - 88rpx); margin: 10rpx 0 0 88rpx; box-sizing: border-box; color: #8a93a6; font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; }
.healthy-card { width: calc(100% - 56rpx); margin: 30rpx auto 0; padding: 28rpx 20rpx 36rpx; box-sizing: border-box; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(40,80,160,.1); text-align: center; }
.healthy-image { display: block; width: 320rpx; height: 320rpx; margin: 0 auto; }
.healthy-title { margin-top: 4rpx; color: #1a2340; font-size: 36rpx; font-weight: 700; }
.healthy-desc { margin-top: 12rpx; color: #8a93a6; font-size: 26rpx; }

.result-bottom { width: calc(100% - 96rpx); margin: 40rpx auto 0; text-align: center; }
/* Override style v2 button defaults before centering the label. */
.result-bottom .back-button, .qr-panel .qr-close { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 0; box-sizing: border-box; padding: 0; line-height: 1.25; }
.action-button-label { display: block; line-height: 1.25; }
.result-bottom .back-button { height: 92rpx; border: 0; border-radius: 46rpx; background: #3b82e8; box-shadow: 0 12rpx 32rpx rgba(59,130,232,.3); color: #fff; font-size: 32rpx; font-weight: 600; }
.contact-button { margin-top: 24rpx; padding: 0; border: 0; background: transparent; color: #3b82e8; font-size: 28rpx; line-height: 1.5; }
.contact-phone { margin-top: 12rpx; color: #9aa5bb; font-size: 24rpx; }

.qr-modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; }
.qr-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,.55); }
.qr-panel { position: absolute; top: 50%; left: 50%; width: 78%; padding: 36rpx 30rpx 28rpx; box-sizing: border-box; border-radius: 20rpx; background: #fff; text-align: center; transform: translate(-50%,-50%); }
.qr-title { color: #1a2340; font-size: 32rpx; font-weight: 700; }
.qr-image { display: block; width: 360rpx; height: 360rpx; margin: 24rpx auto 18rpx; }
.qr-tip { color: #8a93a6; font-size: 26rpx; }
.qr-panel .qr-close { height: 76rpx; margin-top: 24rpx; border: 0; border-radius: 38rpx; background: #eef5ff; color: #3b82e8; font-size: 28rpx; }
