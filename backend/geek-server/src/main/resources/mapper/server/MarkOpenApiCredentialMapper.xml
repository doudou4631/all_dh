<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geek.server.mapper.MarkOpenApiCredentialMapper">
  <resultMap id="credential" type="com.geek.server.domain.MarkOpenApiCredential">
    <id property="id" column="id"/><result property="apiKey" column="api_key"/><result property="secretHash" column="secret_hash"/>
    <result property="userId" column="user_id"/><result property="userName" column="user_name"/><result property="expireTime" column="expire_time"/><result property="lastUsedTime" column="last_used_time"/><result property="createTime" column="create_time"/>
  </resultMap>
  <sql id="columns">c.id,c.name,c.api_key,c.secret_hash,c.user_id,u.user_name,c.status,c.scopes,c.expire_time,c.last_used_time,c.create_time</sql>
  <select id="selectList" resultMap="credential">
    select <include refid="columns"/>
    from mark_open_api_credential c
    left join sys_user u on u.user_id=c.user_id
    <where>
      <if test="name!=null and name!=''">c.name like concat('%',#{name},'%')</if>
      <if test="status!=null and status!=''">and c.status=#{status}</if>
    </where>
    order by c.id desc
  </select>
  <select id="selectByApiKey" resultMap="credential">select <include refid="columns"/> from mark_open_api_credential c left join sys_user u on u.user_id=c.user_id where c.api_key=#{apiKey} limit 1</select>
  <select id="selectById" resultMap="credential">select <include refid="columns"/> from mark_open_api_credential c left join sys_user u on u.user_id=c.user_id where c.id=#{id}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into mark_open_api_credential(name,api_key,secret_hash,user_id,status,scopes,expire_time,create_by,create_time) values(#{name},#{apiKey},#{secretHash},#{userId},#{status},#{scopes},#{expireTime},'admin',now())</insert>
  <update id="updateStatus">update mark_open_api_credential set status=#{status},update_time=now() where id=#{id}</update>
  <update id="updateSecret">update mark_open_api_credential set secret_hash=#{secretHash},last_used_time=null,update_time=now() where id=#{id}</update>
  <update id="updateLastUsed">update mark_open_api_credential set last_used_time=now() where id=#{id}</update>
  <delete id="deletePlatforms">delete from mark_open_api_credential_platform where credential_id=#{credentialId}</delete>
  <insert id="insertPlatform">insert into mark_open_api_credential_platform(credential_id,platform_code) values(#{credentialId},lower(#{platformCode}))</insert>
  <select id="selectPlatforms" resultType="string">select platform_code from mark_open_api_credential_platform where credential_id=#{credentialId}</select>
  <select id="selectItemPlatform" resultType="string">select o.platform_code from mark_order_item i join mark_order o on o.id=i.order_id where i.id=#{itemId}</select>
  <insert id="insertAccessLog">insert into mark_open_api_access_log(credential_id,api_key,request_path,http_method,platform_code,success,message,elapsed_ms,create_time) values(#{credentialId},#{apiKey},#{requestPath},#{httpMethod},#{platformCode},#{success},#{message},#{elapsedMs},now())</insert>
</mapper>
