<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geek.server.mapper.MobilePageConfigMapper">

    <resultMap id="MobilePageConfigResult" type="MobilePageConfig">
        <result property="id" column="id"/>
        <result property="pageCode" column="page_code"/>
        <result property="pageName" column="page_name"/>
        <result property="servicePhone" column="service_phone"/>
        <result property="wechatQrUrl" column="wechat_qr_url"/>
        <result property="navHomeUrl" column="nav_home_url"/>
        <result property="navQueryUrl" column="nav_query_url"/>
        <result property="navBatchUrl" column="nav_batch_url"/>
        <result property="navProfileUrl" column="nav_profile_url"/>
        <result property="resultBackUrl" column="result_back_url"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectMobilePageConfigVo">
        select
            mpc.id,
            mpc.page_code,
            mpc.page_name,
            mpc.service_phone,
            mpc.wechat_qr_url,
            mpc.nav_home_url,
            mpc.nav_query_url,
            mpc.nav_batch_url,
            mpc.nav_profile_url,
            mpc.result_back_url,
            mpc.status,
            mpc.sort,
            mpc.del_flag,
            mpc.create_by,
            mpc.create_time,
            mpc.update_by,
            mpc.update_time,
            mpc.remark
        from mobile_page_config mpc
    </sql>

    <select id="selectMobilePageConfigList" parameterType="MobilePageConfig" resultMap="MobilePageConfigResult">
        <include refid="selectMobilePageConfigVo"/>
        <where>
            and mpc.del_flag = '0'
            <if test="pageCode != null and pageCode != ''">
                and mpc.page_code like concat('%', #{pageCode}, '%')
            </if>
            <if test="pageName != null and pageName != ''">
                and mpc.page_name like concat('%', #{pageName}, '%')
            </if>
            <if test="status != null and status != ''">
                and mpc.status = #{status}
            </if>
        </where>
        order by mpc.sort asc, mpc.id asc
    </select>

    <select id="selectMobilePageConfigById" parameterType="Long" resultMap="MobilePageConfigResult">
        <include refid="selectMobilePageConfigVo"/>
        where mpc.id = #{id}
          and mpc.del_flag = '0'
        limit 1
    </select>

    <select id="selectMobilePageConfigByPageCode" resultMap="MobilePageConfigResult">
        <include refid="selectMobilePageConfigVo"/>
        where mpc.page_code = #{pageCode}
          and mpc.del_flag = '0'
        limit 1
    </select>

    <insert id="insertMobilePageConfig" parameterType="MobilePageConfig" useGeneratedKeys="true" keyProperty="id">
        insert into mobile_page_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pageCode != null and pageCode != ''">page_code,</if>
            <if test="pageName != null and pageName != ''">page_name,</if>
            <if test="servicePhone != null and servicePhone != ''">service_phone,</if>
            <if test="wechatQrUrl != null and wechatQrUrl != ''">wechat_qr_url,</if>
            <if test="navHomeUrl != null and navHomeUrl != ''">nav_home_url,</if>
            <if test="navQueryUrl != null and navQueryUrl != ''">nav_query_url,</if>
            <if test="navBatchUrl != null and navBatchUrl != ''">nav_batch_url,</if>
            <if test="navProfileUrl != null and navProfileUrl != ''">nav_profile_url,</if>
            <if test="resultBackUrl != null and resultBackUrl != ''">result_back_url,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sort != null">sort,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pageCode != null and pageCode != ''">#{pageCode},</if>
            <if test="pageName != null and pageName != ''">#{pageName},</if>
            <if test="servicePhone != null and servicePhone != ''">#{servicePhone},</if>
            <if test="wechatQrUrl != null and wechatQrUrl != ''">#{wechatQrUrl},</if>
            <if test="navHomeUrl != null and navHomeUrl != ''">#{navHomeUrl},</if>
            <if test="navQueryUrl != null and navQueryUrl != ''">#{navQueryUrl},</if>
            <if test="navBatchUrl != null and navBatchUrl != ''">#{navBatchUrl},</if>
            <if test="navProfileUrl != null and navProfileUrl != ''">#{navProfileUrl},</if>
            <if test="resultBackUrl != null and resultBackUrl != ''">#{resultBackUrl},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMobilePageConfig" parameterType="MobilePageConfig">
        update mobile_page_config
        <trim prefix="set" suffixOverrides=",">
            <if test="pageCode != null and pageCode != ''">page_code = #{pageCode},</if>
            <if test="pageName != null and pageName != ''">page_name = #{pageName},</if>
            <if test="servicePhone != null and servicePhone != ''">service_phone = #{servicePhone},</if>
            <if test="wechatQrUrl != null and wechatQrUrl != ''">wechat_qr_url = #{wechatQrUrl},</if>
            <if test="navHomeUrl != null and navHomeUrl != ''">nav_home_url = #{navHomeUrl},</if>
            <if test="navQueryUrl != null and navQueryUrl != ''">nav_query_url = #{navQueryUrl},</if>
            <if test="navBatchUrl != null and navBatchUrl != ''">nav_batch_url = #{navBatchUrl},</if>
            <if test="navProfileUrl != null and navProfileUrl != ''">nav_profile_url = #{navProfileUrl},</if>
            <if test="resultBackUrl != null and resultBackUrl != ''">result_back_url = #{resultBackUrl},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
          and del_flag = '0'
    </update>

    <delete id="deleteMobilePageConfigById" parameterType="Long">
        delete from mobile_page_config
        where id = #{id}
    </delete>

    <delete id="deleteMobilePageConfigByIds">
        delete from mobile_page_config
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectPublicConfigByPageCode" resultMap="MobilePageConfigResult">
        <include refid="selectMobilePageConfigVo"/>
        where mpc.page_code = #{pageCode}
          and mpc.status = '0'
          and mpc.del_flag = '0'
        limit 1
    </select>

    <select id="selectFirstPublicConfig" resultMap="MobilePageConfigResult">
        <include refid="selectMobilePageConfigVo"/>
        where mpc.status = '0'
          and mpc.del_flag = '0'
        order by mpc.sort asc, mpc.id asc
        limit 1
    </select>
</mapper>
