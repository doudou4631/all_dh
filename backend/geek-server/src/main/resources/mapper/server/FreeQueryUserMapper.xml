<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geek.server.mapper.FreeQueryUserMapper">

    <resultMap id="FreeQueryUserResult" type="FreeQueryUser">
        <result property="id" column="id"/>
        <result property="account" column="account"/>
        <result property="password" column="password"/>
        <result property="nickName" column="nick_name"/>
        <result property="phone" column="phone"/>
        <result property="points" column="points"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectFreeQueryUserVo">
        select
            fqu.id,
            fqu.account,
            fqu.password,
            fqu.nick_name,
            fqu.phone,
            fqu.points,
            fqu.status,
            fqu.create_by,
            fqu.create_time,
            fqu.update_by,
            fqu.update_time,
            fqu.remark
        from free_query_user fqu
    </sql>

    <select id="selectFreeQueryUserById" parameterType="Long" resultMap="FreeQueryUserResult">
        <include refid="selectFreeQueryUserVo"/>
        where fqu.id = #{id}
          and fqu.del_flag = '0'
        limit 1
    </select>

    <select id="selectFreeQueryUserByAccount" resultMap="FreeQueryUserResult">
        <include refid="selectFreeQueryUserVo"/>
        where fqu.account = #{account}
          and fqu.del_flag = '0'
        limit 1
    </select>

    <select id="selectFreeQueryUserByPhone" resultMap="FreeQueryUserResult">
        <include refid="selectFreeQueryUserVo"/>
        where fqu.phone = #{phone}
          and fqu.del_flag = '0'
        limit 1
    </select>

    <select id="selectFreeQueryUserList" parameterType="FreeQueryUser" resultMap="FreeQueryUserResult">
        <include refid="selectFreeQueryUserVo"/>
        <where>
            and fqu.del_flag = '0'
            <if test="account != null and account != ''">
                and fqu.account like concat('%', #{account}, '%')
            </if>
            <if test="nickName != null and nickName != ''">
                and fqu.nick_name like concat('%', #{nickName}, '%')
            </if>
            <if test="phone != null and phone != ''">
                and fqu.phone like concat('%', #{phone}, '%')
            </if>
            <if test="status != null and status != ''">
                and fqu.status = #{status}
            </if>
        </where>
        order by fqu.id desc
    </select>

    <insert id="insertFreeQueryUser" parameterType="FreeQueryUser" useGeneratedKeys="true" keyProperty="id">
        insert into free_query_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="account != null and account != ''">account,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="phone != null">phone,</if>
            <if test="points != null">points,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="account != null and account != ''">#{account},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="points != null">#{points},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateFreeQueryUser" parameterType="FreeQueryUser">
        update free_query_user
        <trim prefix="set" suffixOverrides=",">
            <if test="account != null and account != ''">account = #{account},</if>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
          and del_flag = '0'
    </update>

    <update id="updateFreeQueryUserPassword">
        update free_query_user
        set password = #{password},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where id = #{id}
          and del_flag = '0'
    </update>

    <update id="updateFreeQueryUserLoginInfo">
        update free_query_user
        set last_login_ip = #{lastLoginIp},
            last_login_time = #{lastLoginTime},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where id = #{id}
          and del_flag = '0'
    </update>

    <update id="increasePoints">
        update free_query_user
        set points = points + #{pointDelta},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where id = #{id}
          and del_flag = '0'
    </update>

    <update id="deductPoints">
        update free_query_user
        set points = points - #{pointDelta},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where id = #{id}
          and del_flag = '0'
          and status = '0'
          and points >= #{pointDelta}
    </update>

    <update id="deleteFreeQueryUserByIds">
        update free_query_user
        set del_flag = '2',
            update_by = #{updateBy},
            update_time = #{updateTime}
        where del_flag = '0'
          and id in
          <foreach collection="ids" item="id" open="(" separator="," close=")">
              #{id}
          </foreach>
    </update>
</mapper>
