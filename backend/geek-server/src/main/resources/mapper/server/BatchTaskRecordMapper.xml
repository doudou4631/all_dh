<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geek.server.mapper.BatchTaskRecordMapper">

    <resultMap type="BatchTaskRecord" id="BatchTaskRecordResult">
        <result property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="userId" column="user_id"/>
        <result property="taskName" column="task_name"/>
        <result property="status" column="status"/>
        <result property="totalCount" column="total_count"/>
        <result property="completedCount" column="completed_count"/>
        <result property="successCount" column="success_count"/>
        <result property="failedCount" column="failed_count"/>
        <result property="percentage" column="percentage"/>
        <result property="phoneNumbers" column="phone_numbers"/>
        <result property="platformConfigs" column="platform_configs"/>
        <result property="description" column="description"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectBatchTaskRecordVo">
        select id, task_id, user_id, task_name, status, total_count, completed_count,
               success_count, failed_count, percentage, phone_numbers, platform_configs,
               description, error_message, create_by, create_time, update_by, update_time,
               start_time, end_time, del_flag, remark
        from batch_task_record
    </sql>

    <select id="selectByUserId" parameterType="Long" resultMap="BatchTaskRecordResult">
        <include refid="selectBatchTaskRecordVo"/>
        where user_id = #{userId} and del_flag = '0'
        order by create_time desc
    </select>

    <select id="selectByUserIdAndStatus" parameterType="Long" resultMap="BatchTaskRecordResult">
        <include refid="selectBatchTaskRecordVo"/>
        where user_id = #{userId} and status = #{status} and del_flag = '0'
        order by create_time desc
    </select>

    <select id="selectByTaskId" parameterType="String" resultMap="BatchTaskRecordResult">
        <include refid="selectBatchTaskRecordVo"/>
        where task_id = #{taskId} and del_flag = '0'
    </select>

    <select id="selectByUserIdAfterTime" parameterType="Long" resultMap="BatchTaskRecordResult">
        <include refid="selectBatchTaskRecordVo"/>
        where user_id = #{userId} and create_time >= #{startTime} and del_flag = '0'
        order by create_time desc
    </select>

    <update id="updateTaskStatus" parameterType="String">
        update batch_task_record
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="completedCount != null">completed_count = #{completedCount},</if>
            <if test="successCount != null">success_count = #{successCount},</if>
            <if test="failedCount != null">failed_count = #{failedCount},</if>
            <if test="percentage != null">percentage = #{percentage},</if>
            <if test="errorMessage != null and errorMessage != ''">error_message = #{errorMessage},</if>
            update_time = sysdate()
        </set>
        where task_id = #{taskId} and del_flag = '0'
    </update>

    <update id="updateTaskEndTime">
        update batch_task_record
        set end_time = #{endTime}, update_time = sysdate()
        where task_id = #{taskId} and del_flag = '0'
    </update>

    <delete id="deleteExpiredRecords" parameterType="Date">
        delete from batch_task_record
        where create_time &lt; #{beforeTime} and status in ('COMPLETED', 'FAILED', 'CANCELLED')
    </delete>

    <select id="selectByUserIdAndTaskIds" resultType="com.geek.server.domain.entity.BatchTaskRecord">
        <include refid="selectBatchTaskRecordVo"/>
        where user_id = #{userId} and task_id in #{taskIds} and del_flag = '0'
        order by create_time desc
    </select>
</mapper>
