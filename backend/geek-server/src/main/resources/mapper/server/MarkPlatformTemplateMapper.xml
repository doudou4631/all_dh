<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geek.server.mapper.MarkPlatformTemplateMapper">

    <resultMap type="MarkPlatformTemplate" id="MarkPlatformTemplateResult">
        <result property="id" column="id"/>
        <result property="templateName" column="template_name"/>
        <result property="templateInfo" column="template_info"/>
        <result property="status" column="status"/>
        <result property="isDefault" column="is_default"/>
        <result property="ownerUserId" column="owner_user_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectMarkPlatformTemplateVo">
        select
            mpt.id,
            mpt.template_name,
            mpt.template_info,
            mpt.status,
            mpt.is_default,
            mpt.owner_user_id,
            mpt.create_by,
            mpt.create_time,
            mpt.update_by,
            mpt.update_time,
            mpt.remark
        from mark_platform_template mpt
    </sql>

    <select id="selectMarkPlatformTemplateById" parameterType="Long" resultMap="MarkPlatformTemplateResult">
        <include refid="selectMarkPlatformTemplateVo"/>
        where mpt.id = #{id}
    </select>
    <select id="selectMarkPlatformTemplateByOwnerAndName" resultMap="MarkPlatformTemplateResult">
        <include refid="selectMarkPlatformTemplateVo"/>
        where mpt.owner_user_id = #{ownerUserId}
          and mpt.template_name = #{templateName}
        order by mpt.id asc
        limit 1
    </select>
    <select id="selectOwnerDefaultTemplate" parameterType="Long" resultMap="MarkPlatformTemplateResult">
        <include refid="selectMarkPlatformTemplateVo"/>
        where mpt.owner_user_id = #{ownerUserId}
          and mpt.is_default = '1'
          and mpt.status = '0'
        order by mpt.id asc
        limit 1
    </select>

    <select id="selectMarkPlatformTemplateList" parameterType="MarkPlatformTemplate" resultMap="MarkPlatformTemplateResult">
        <include refid="selectMarkPlatformTemplateVo"/>
        <where>
            <if test="templateName != null and templateName != ''"> and mpt.template_name like concat('%', #{templateName}, '%')</if>
            <if test="status != null and status != ''"> and mpt.status = #{status}</if>
            <if test="isDefault != null and isDefault != ''"> and mpt.is_default = #{isDefault}</if>
            <if test="ownerUserId != null"> and mpt.owner_user_id = #{ownerUserId}</if>
        </where>
        order by mpt.is_default desc, mpt.id desc
    </select>

    <insert id="insertMarkPlatformTemplate" parameterType="MarkPlatformTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into mark_platform_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="templateInfo != null and templateInfo != ''">template_info,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="ownerUserId != null">owner_user_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="templateInfo != null and templateInfo != ''">#{templateInfo},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="ownerUserId != null">#{ownerUserId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMarkPlatformTemplate" parameterType="MarkPlatformTemplate">
        update mark_platform_template
        <trim prefix="set" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="templateInfo != null and templateInfo != ''">template_info = #{templateInfo},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>
    <update id="clearOwnerDefaultTemplate">
        update mark_platform_template
        set is_default = '0'
        where owner_user_id = #{ownerUserId}
          and is_default = '1'
          and (#{excludeId} is null or id &lt;&gt; #{excludeId})
    </update>
    <select id="countActiveUserBindingsByTemplateId" parameterType="Long" resultType="long">
        select count(1)
        from sys_user u
        where u.rel_mark_template = #{templateId}
          and u.del_flag = 0
    </select>

    <delete id="deleteMarkPlatformTemplateByIds" parameterType="Long">
        delete from mark_platform_template where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
