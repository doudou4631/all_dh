<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.geek.server.mapper.UserAggregateConfigMapper">
    
    <resultMap type="UserAggregateConfig" id="UserAggregateConfigResult">
        <result property="id" column="id" />
        <result property="aggregateName" column="aggregate_name" />
        <result property="sid" column="sid" />
        <result property="sKey" column="s_key" />
        <result property="configParams" column="config_params" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectUserAggregateConfigVo">
        select 
            uac.id,
            uac.aggregate_name,
            uac.sid,
            uac.s_key,
            uac.config_params,
            uac.status,
            uac.create_by,
            uac.create_time,
            uac.update_by,
            uac.update_time,
            uac.remark
        from user_aggregate_config uac
    </sql>

    <select id="selectUserAggregateConfigList" parameterType="UserAggregateConfig" resultMap="UserAggregateConfigResult">
        <include refid="selectUserAggregateConfigVo"/>
        <where>
            <if test="aggregateName != null  and aggregateName != ''"> and uac.aggregate_name like concat('%', #{aggregateName}, '%')</if>
            <if test="sid != null  and sid != ''"> and uac.sid = #{sid}</if>
            <if test="sKey != null  and sKey != ''"> and uac.s_key = #{sKey}</if>
            <if test="configParams != null  and configParams != ''"> and uac.config_params = #{configParams}</if>
            <if test="status != null  and status != ''"> and uac.status = #{status}</if>
        </where>
    </select>
    
    <select id="selectUserAggregateConfigById" parameterType="Long" resultMap="UserAggregateConfigResult">
        <include refid="selectUserAggregateConfigVo"/>
        where uac.id = #{id}
    </select>
        
    <insert id="insertUserAggregateConfig" parameterType="UserAggregateConfig" useGeneratedKeys="true" keyProperty="id">
        insert into user_aggregate_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="aggregateName != null and aggregateName != ''">aggregate_name,</if>
            <if test="sid != null and sid != ''">sid,</if>
            <if test="sKey != null and sKey != ''">s_key,</if>
            <if test="configParams != null">config_params,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="aggregateName != null and aggregateName != ''">#{aggregateName},</if>
            <if test="sid != null and sid != ''">#{sid},</if>
            <if test="sKey != null and sKey != ''">#{sKey},</if>
            <if test="configParams != null">#{configParams},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateUserAggregateConfig" parameterType="UserAggregateConfig">
        update user_aggregate_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="aggregateName != null and aggregateName != ''">aggregate_name = #{aggregateName},</if>
            <if test="sid != null and sid != ''">sid = #{sid},</if>
            <if test="sKey != null and sKey != ''">s_key = #{sKey},</if>
            <if test="configParams != null">config_params = #{configParams},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where user_aggregate_config.id = #{id}
    </update>

    <delete id="deleteUserAggregateConfigById" parameterType="Long">
        delete from user_aggregate_config where id = #{id}
    </delete>

    <delete id="deleteUserAggregateConfigByIds" parameterType="String">
        delete from user_aggregate_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>